FROM golang:1.23-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /service ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /service /service
EXPOSE {{SERVICE_PORT}}
ENTRYPOINT ["/service"]
