    // --- Always deny: secret exposure ---
    // REMOVED: "env | grep *KEY/SECRET/TOKEN/PASSWORD*". V2 splits pipelines into separate
    // commands, so a pattern containing "|" never matches. The bare `env` ask above covers it.
    {
      "action": "shell",
      "resource": "cat ~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat ~/.gnupg/*",
      "effect": "deny"
    },
