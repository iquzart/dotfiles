// ============================================================
// opencode.jsonc — AI Coding + Terminal Assistant (OpenCode 2.x native format)
// Place at: ~/.config/opencode/opencode.jsonc
// Docs: https://opencode.ai/v2/docs/config
//
// This file uses the native V2 shape. Do NOT point OpenCode 1.x at it.
// Log level is no longer a config field. Start OpenCode with:
//   export OPENCODE_LOG_LEVEL=WARN
// ============================================================
{
  "$schema": "https://opencode.ai/config.json",
  // ============================================================
  // GENERAL
  // ============================================================
  "shell": "/bin/bash",
  "share": "disabled",
  "update": "notify", // was: autoupdate
  "snapshots": true, // was: snapshot
  // ============================================================
  // DEFAULT AGENT & MODELS
  // OpenAI is the active provider. Ollama is parked (see PLUGINS).
  // small_model now lives on the built-in "title" agent (see AGENTS).
  // ============================================================
  "default_agent": "core-agent",
  "model": "openai/gpt-6.1-sol",
  // ============================================================
  // PLUGINS
  // V1 plugins do not run in V2. Port them before adding here.
  // "-opencode.provider.ollama" disables Ollama auto-discovery
  // (V2 probes http://127.0.0.1:11434 by default). Remove that
  // entry to re-enable local Ollama models.
  // ============================================================
  "plugins": [
    "-opencode.provider.ollama"
  ],
  // ============================================================
  // SKILLS
  // V2 takes one ordered array of paths and URLs.
  // Place skill dirs at: ~/.config/opencode/skills/<skill-id>/SKILL.md
  // ============================================================
  "skills": [
    "~/.config/opencode/skills"
  ],
  // ============================================================
  // MCP SERVERS
  // Servers live under mcp.servers; "enabled" became "disabled".
  // Env vars are resolved by the OpenCode background service, so export
  // them BEFORE the service starts (restart it after changing them).
  // ============================================================
  "mcp": {
    "servers": {
      "grafana": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-grafana"
        ],
        "disabled": false,
        "environment": {
          "GRAFANA_URL": "{env:GRAFANA_URL}",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
        }
      },
      "atlassian": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-atlassian"
        ],
        "disabled": false,
        "environment": {
          "JIRA_URL": "{env:JIRA_URL}",
          "JIRA_USERNAME": "{env:JIRA_USERNAME}",
          "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
          // Confluence tools need their own credentials. Uncomment and export these
          // if the doc agent should read/write Confluence pages:
          // "CONFLUENCE_URL": "{env:CONFLUENCE_URL}",
          // "CONFLUENCE_USERNAME": "{env:CONFLUENCE_USERNAME}",
          // "CONFLUENCE_API_TOKEN": "{env:CONFLUENCE_API_TOKEN}"
        }
      }
    }
  },
  // ============================================================
  // PROVIDERS
  // "provider" -> "providers"; "npm" -> "package" (aisdk: prefix);
  // "options" -> "settings"; model flags -> "capabilities".
  // ============================================================
  "providers": {
    // ----------------------------------------------------------
    // FREE PUBLIC: OpenRouter
    // Uses V2's native OpenRouter runtime. The key is read from
    // OPENROUTER_API_KEY automatically (export OPENROUTER_API_KEY=sk-or-...).
    // Used for: docs agent (large context, writing quality)
    // ----------------------------------------------------------
    "openrouter": {
      "name": "OpenRouter (Free Public)",
      "models": {
        // Large context — runbooks, ADRs, long docs
        "meta-llama/llama-4-scout:free": {
          "name": "Llama 4 Scout (Free)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        // Efficient writing — READMEs, changelogs, specs
        "mistralai/mistral-small-3.2-24b-instruct:free": {
          "name": "Mistral Small 3.2 (Free)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    // ----------------------------------------------------------
    // ACTIVE: OpenAI (AI Hub gateway)
    // Export: export OPENAI_API_KEY=sk-... OPENAI_BASE_URL=https://...
    // ----------------------------------------------------------
    "openai": {
      "name": "OpenAI (AI Hub)",
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "{env:OPENAI_BASE_URL}"
      },
      "models": {
        // Best cost/quality — complex code, hard reviews
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        // Deep reasoning — architecture decisions
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  // ============================================================
  // GLOBAL PERMISSIONS
  // One ordered array. The LAST matching rule wins, so order is:
  //   1. catch-all ask  2. allows  3. asks  4. safe sub-forms re-allowed
  //   5. loophole re-gates  6. hard denies (always last)
  // Agent-level permissions are appended after these and can override them.
  // Actions renamed: bash -> shell. A trailing " *" also matches the bare command.
  // Any deny in a compound command denies the whole command.
  // Anything not listed falls back to V2's base policy (allow, with
  // external_directory asking).
  // ============================================================
  "permissions": [
    // --- Reads open; secrets closed ---
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.aws/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.gnupg/*",
      "effect": "deny"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    // --- Edits ---
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*/.aws/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*/.gnupg/*",
      "effect": "deny"
    },
    // --- Web ---
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    },
    // --- Directories outside the project ---
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Documents/workspace/*",
      "effect": "allow"
    },
    // ========================================================
    // SHELL
    // ========================================================
    // --- Catch-all: anything not listed below prompts ---
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    // --- Safe read-only ---
    {
      "action": "shell",
      "resource": "ls",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls -la *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "whoami",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "echo *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "which *",
      "effect": "allow"
    },
    // CHANGED: was allow. A bare `env` dumps every exported secret (OPENAI_API_KEY, tokens).
    {
      "action": "shell",
      "resource": "env",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "uname *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "date",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uptime",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ps *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "top -bn1",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "df *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "du *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "free *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "lsof *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "awk *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sed *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cut *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sort *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uniq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "wc *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tr *",
      "effect": "allow"
    },
    {
      "action": "shell",
