{
  // ============================================================
  // opencode.jsonc — AI Coding + Terminal Assistant
  // Place at: ~/.config/opencode/opencode.jsonc
  // Docs: https://opencode.ai/docs
  // ============================================================
  "$schema": "https://opencode.ai/config.json",
  // ============================================================
  // GENERAL
  // ============================================================
  "shell": "/bin/bash",
  "logLevel": "WARN",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  // ============================================================
  // DEFAULT AGENT & MODELS
  // OpenAI is the active provider. Ollama is retained below but disabled.
  // ============================================================
  "default_agent": "core-agent",
  "model": "openai/gpt-6.1-sol",
  // Use Sol until a lower-latency OpenAI model is configured.
  "small_model": "openai/gpt-5.6-terra",
  // ============================================================
  // Plugins
  // ============================================================
  "plugin": [
    "opencode-plugin-openspec",
  ],
  // ============================================================
  // SKILLS
  // Loaded on demand per agent — never global
  // Place skill files at: ~/.config/opencode/skills/
  // ============================================================
  "skills": {
    "paths": [
      "~/.config/opencode/skills"
    ]
  },
  // ============================================================
  // MCP SERVERS
  // Grafana tools are scoped to reliability-engineer; Atlassian tools are scoped to doc-agent.
  // Required environment variables must be set before use.
  // ============================================================
  "mcp": {
    "grafana": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-grafana"
      ],
      "enabled": true,
      "environment": {
        "GRAFANA_URL": "{env:GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "atlassian": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-atlassian"
      ],
      "enabled": true,
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    }
  },
  // ============================================================
  // PROVIDERS
  // ============================================================
  "provider": {
    /*
    // ----------------------------------------------------------
    // PARKED: Ollama
    // To reactivate, remove this block comment and set model and
    // small_model above to fully-qualified ollama/<model> values.
    // Start: ollama serve
    // Pull:  ollama pull gemma4:e4b && ollama pull qwen3:balanced
    // ----------------------------------------------------------
    "ollama": {
      "name": "Ollama (Local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "thinking": false
      },
      "models": {
        // Primary coder — best local quality
        "gemma4:e4b": {
          "name": "Gemma4 4B (Coder)",
          "tools": true,
          "reasoning": false,
          "vision": false
        },
        // Fast model — router and quick tasks
        "gemma4:e2b": {
          "name": "Gemma4 2B (Router/Fast)",
          "tools": true,
          "reasoning": false,
          "vision": false
        },
        // Fast model — router and quick tasks
        "qwen25coder:stable": {
          "name": "Qwen2.5 Coder 7B (Router/Fast)",
          "tools": true,
          "reasoning": false,
          "vision": false
        },
        // Reasoning — complex infra, debugging
        "qwen3:balanced": {
          "name": "Qwen3 Balanced (Reasoning)",
          "tools": true,
          "reasoning": false,
          "vision": false
        },
        // Extended reasoning — architecture, hard problems
        "qwen35:balanced": {
          "name": "Qwen3.5 Balanced (Deep Reasoning)",
          "tools": true,
          "reasoning": false,
          "vision": false
        }
      }
    },
    */
    // ----------------------------------------------------------
    // FREE PUBLIC: OpenRouter
    // Get free key: https://openrouter.ai
    // Export: export OPENROUTER_API_KEY=sk-or-...
    // Used for: docs agent (large context, writing quality)
    // ----------------------------------------------------------
    "openrouter": {
      "name": "OpenRouter (Free Public)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}"
      },
      "models": {
        // Large context — runbooks, ADRs, long docs
        "meta-llama/llama-4-scout:free": {
          "name": "Llama 4 Scout (Free)",
          "tools": true,
          "reasoning": false,
          "vision": true
        },
        // Efficient writing — READMEs, changelogs, specs
        "mistralai/mistral-small-3.2-24b-instruct:free": {
          "name": "Mistral Small 3.2 (Free)",
          "tools": true,
          "reasoning": false,
          "vision": false
        }
      }
    },
    // ----------------------------------------------------------
    // ACTIVE: OpenAI
    // Export: export OPENAI_API_KEY=sk-...
    // ----------------------------------------------------------
    "openai": {
      "name": "OpenAI (AI Hub)",
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "{env:OPENAI_BASE_URL}"
      },
      "models": {
        // Best cost/quality — complex code, hard reviews
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol",
          "tools": true,
          "reasoning": true,
          "vision": true
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "tools": true,
          "reasoning": true,
          "vision": true
        },
        // Deep reasoning — architecture decisions
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "tools": true,
          "reasoning": true,
          "vision": false
        }
      }
    }
  },
  // ============================================================
  // GLOBAL PERMISSIONS
  // Reads open. Writes/exec gated. Secrets always denied.
  // Agent-level permissions override these where needed.
  // ORDER MATTERS: later matching rules win.
  //   1. catch-all ask  2. allows  3. asks  4. safe sub-forms re-allowed
  //   5. loophole re-gates  6. hard denies (always last)
  // ============================================================
  "permission": {
    "read": "allow",
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.gnupg/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "codesearch": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "todowrite": "allow",
    "external_directory": {
      "/tmp/**": "allow",
      "~/Documents/workspace/**": "allow"
    },
    "bash": {
      // --- Catch-all: anything not listed below prompts ---
      "*": "ask",
      // --- Safe read-only ---
      "ls": "allow",
      "ls *": "allow",
      "ls -la *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "which *": "allow",
      "env": "allow",
      "uname *": "allow",
      "date": "allow",
      "uptime": "allow",
      "ps *": "allow",
      "top -bn1": "allow",
      "df *": "allow",
      "du *": "allow",
      "free *": "allow",
      "lsof *": "allow",
      "jq *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "cut *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "tr *": "allow",
      "curl -s *": "allow",
      "curl --silent *": "allow",
      "dig *": "allow",
      "ping -c *": "allow",
      // added
      "cd *": "allow",
      "test *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "tree *": "allow",
      "diff *": "allow",
      // --- Kubernetes read-only ---
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "kubectl explain *": "allow",
      "kubectl top *": "allow",
      "kubectl diff *": "allow",
      "kubectl version *": "allow",
      "kubectl cluster-info *": "allow",
      "kubectl api-resources *": "allow",
      "kubectl events *": "allow",
      "kubectl auth *": "allow",
      // added: namespace/context forms and misc read-only
      "kubectl -n * get *": "allow",
      "kubectl -n * describe *": "allow",
      "kubectl -n * logs *": "allow",
      "kubectl --namespace * get *": "allow",
      "kubectl --context * get *": "allow",
      "kubectl --context * describe *": "allow",
      "kubectl --context * logs *": "allow",
      "kubectl config get-contexts*": "allow",
      "kubectl config current-context": "allow",
      "kubectl wait *": "allow",
      // --- Helm read-only ---
      "helm list *": "allow",
      "helm get *": "allow",
      "helm history *": "allow",
      "helm lint *": "allow",
      "helm template *": "allow",
      "helm show *": "allow",
      "helm search *": "allow",
      "helm version *": "allow",
      "helm repo list*": "allow",
      // --- Kind read-only ---
      "kind get *": "allow",
      "kind export *": "allow",
      // --- Git: broad allow FIRST, gates and denies come after ---
      "git *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "git remote *": "allow",
      "git stash list": "allow",
      "git tag *": "allow",
      "git add *": "allow",
      "git fetch *": "allow",
      // --- GitHub CLI read-only ---
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      // --- Docker read-only ---
      "docker ps *": "allow",
      "docker images *": "allow",
      "docker logs *": "allow",
      "docker inspect *": "allow",
      // --- Write/exec: ask ---
      "npm *": "ask",
      "npx *": "ask",
      "pip *": "ask",
      "pip3 *": "ask",
      "go *": "ask",
      "make *": "ask",
      "docker build *": "ask",
      "docker run *": "ask",
      "docker pull *": "ask",
      "kubectl apply *": "ask",
      "kubectl delete *": "ask",
      "kubectl exec *": "ask",
      "kubectl port-forward *": "ask",
      "kubectl rollout *": "ask",
      "kubectl patch *": "ask",
      "kubectl create *": "ask",
      "helm install *": "ask",
      "helm upgrade *": "ask",
      "helm uninstall *": "ask",
      "helm rollback *": "ask",
      "helm dependency *": "ask",
      "helm package *": "ask",
      "kind create *": "ask",
      "kind delete *": "ask",
      "kind load *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git checkout *": "ask",
      "git pull *": "ask",
      "gh pr create *": "ask",
      "bash *": "ask",
      "sh *": "ask",
      "node *": "ask",
      "python *": "ask",
      "python3 *": "ask",
      "ruby *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "cp *": "ask",
      "mv *": "ask",
      "mkdir *": "ask",
      "touch *": "ask",
      "wget *": "ask",
      // --- Safe sub-forms of the asks above (must come AFTER them) ---
      "kubectl rollout status *": "allow",
      "go test *": "allow",
      "go build *": "allow",
      "go vet *": "allow",
      "go list *": "allow",
      "go version*": "allow",
      "go fmt *": "allow",
      "npm --version": "allow",
      "npm ls*": "allow",
      "npm list*": "allow",
      "npm outdated*": "allow",
      "npm view *": "allow",
      "npm info *": "allow",
      "npm explain *": "allow",
      "npm audit*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run build*": "allow",
      "npm run format*": "allow",
      "pip list*": "allow",
      "pip show *": "allow",
      "pip freeze*": "allow",
      "pip check*": "allow",
      "pip3 list*": "allow",
      "pip3 show *": "allow",
      "pip3 freeze*": "allow",
      "python --version": "allow",
      "python3 --version": "allow",
      "python -m pytest *": "allow",
      "python3 -m pytest *": "allow",
      "python -m json.tool*": "allow",
      "python3 -m json.tool*": "allow",
      "python -m py_compile *": "allow",
      "python3 -m py_compile *": "allow",
      "python -m venv *": "allow",
      "python3 -m venv *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "black *": "allow",
      "mypy *": "allow",
      "flake8 *": "allow",
      "bash --version": "allow",
      "bash -n *": "allow",
      "sh -n *": "allow",
      "shellcheck *": "allow",
      "shfmt *": "allow",
      "chmod +x *": "allow",
      "node --version": "allow",
      "node -v": "allow",
      "node --check *": "allow",
      "ruby --version": "allow",
      "ruby -c *": "allow",
      "gem list*": "allow",
      "gem info *": "allow",
      "bundle list*": "allow",
      "bundle check*": "allow",
      "bundle outdated*": "allow",
      "bundle exec *": "ask",
      "bundle exec rspec *": "allow",
      "bundle exec rubocop *": "allow",
      "rspec *": "allow",
      "rubocop *": "allow",
      // --- Loophole re-gates (AFTER the broad allows they patch) ---
      "sed -i *": "ask",
      "find * -delete*": "deny",
      "find * -exec *": "ask",
      "curl * -X *": "ask",
      "curl * -d *": "ask",
      "kubectl get secret*": "ask",
      "kubectl -n * get secret*": "ask",
      "kubectl --namespace * get secret*": "ask",
      "kubectl --context * get secret*": "ask",
      "kubectl auth reconcile*": "ask",
      "npm audit fix*": "ask",
      "pip install *": "ask",
      "pip3 install *": "ask",
      "gem install *": "ask",
      "bundle install*": "ask",
      "bundle update*": "ask",
      "npm install*": "ask",
      "npm ci*": "ask",
      "npm update*": "ask",
      "npm uninstall*": "ask",
      // --- Always deny: destructive ---
      "rm *": "deny",
      "rm -rf *": "deny",
      "rmdir *": "deny",
      "mkfs *": "deny",
      "dd *": "deny",
      "fdisk *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "halt *": "deny",
      "poweroff *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny",
      "chmod -R 777 *": "deny",
      ":(){ :|:& };:": "deny",
      "kubectl delete -A*": "deny",
      "kubectl delete --all*": "deny",
      "terraform apply -auto-approve*": "deny",
      "tofu apply -auto-approve*": "deny",
      "npm publish*": "deny",
      "npm login*": "deny",
      "npm token*": "deny",
      "npm config set*": "deny",
      "gem push *": "deny",
      // --- Always deny: destructive git (AFTER "git *" and the git asks) ---
      "git rm*": "deny",
      "git clean*": "deny",
      "git gc*": "deny",
      "git prune*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git branch --delete*": "deny",
      "git tag -d*": "deny",
      "git tag --delete*": "deny",
      "git push --delete*": "deny",
      "git push * --delete*": "deny",
      "git push -d*": "deny",
      "git push * -d": "deny",
      "git push * -d *": "deny",
      "git push * :*": "deny",
      "git push -f*": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "git push*--force*": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "git restore *": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "git worktree remove*": "deny",
      "git worktree prune*": "deny",
      "git remote remove*": "deny",
      "git remote rm*": "deny",
      "git submodule deinit*": "deny",
      "git reflog expire*": "deny",
      "git reflog delete*": "deny",
      "git filter-branch*": "deny",
      "git update-ref -d*": "deny",
      // --- Always deny: secret exposure ---
      "cat ~/.ssh/*": "deny",
      "cat ~/.gnupg/*": "deny",
      "cat ~/.aws/*": "deny",
      "cat ~/.kube/config": "deny",
      "cat ~/.docker/config.json": "deny",
      "cat ~/.npmrc": "deny",
      "cat ~/.config/gcloud/*": "deny",
      "cat .env": "deny",
      "cat .env.*": "deny",
      "cat */.env": "deny",
      "env | grep *KEY*": "deny",
      "env | grep *SECRET*": "deny",
      "env | grep *TOKEN*": "deny",
      "env | grep *PASSWORD*": "deny",
      "git config --global *": "deny",
      "ls .git/*": "deny",
      "cat .git/*": "deny",
      "find .git/*": "deny"
    }
  },
  // ============================================================
  // AGENTS
  // Core Agent is the primary router. Specialist agents are loaded from
  // ~/.config/opencode/agents and own their defined engineering domains.
  // ============================================================
  "agent": {
    // Disable built-in defaults
    "build": {
      "disable": false
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 8
  }
}
