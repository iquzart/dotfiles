  // ============================================================
  // AGENTS
  // "agent" -> "agents"; "disable" -> "disabled".
  // core-agent and the specialist agents are loaded from
  // ~/.config/opencode/agents/*.md (V1 frontmatter still works).
  // ============================================================
  "agents": {
    // Replaces V1 "small_model" (used for titles / lightweight tasks).
    "title": {
      "model": "openai/gpt-5.6-terra"
    },
    // Built-in defaults
    "build": {
      "disabled": false
    },
    "plan": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  // V2 has no tail_turns / prune; recent context is kept by token budget.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    }
  }
}
